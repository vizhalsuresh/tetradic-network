# ==============================================================================
# TETRADIC NETWORK — Git Ignore Specification
# ==============================================================================

# Node Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
anidoodle-art/node_modules/
anidoodle-art/dist/
anidoodle-art/out/

# Rendered Video Outputs & Stills (Local Renders)
out/
*.mp4
*.mov
*.avi
*.mkv
*.wav
*.flac
*.ecproj.autosave

# Keep reference brand master files, ignore scratch renders
!out/broadcast/
!public/audio/

# Heavy AI Model Checkpoints & Pre-trained Weights (Download via setup script)
models/
*.bin
*.safetensors
*.pth
*.pt
*.onnx

# Binary Archives & Installers
tesseract-cli/
*.zip
*.tar.gz
*.tgz
*.iso

# Python Virtual Environments & Bytecode
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/

# Credentials, OAuth Tokens & Private Secrets
credentials/
*.env
*.env.local
*.env.*.local
*.pem
*.key
youtube_token.json
client_secret.json
token.pickle

# Operating System & IDE Artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.gemini/
